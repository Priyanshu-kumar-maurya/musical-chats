# =========================================================================
# Secret-Bubble Cloud Database & Environment Configuration
# =========================================================================

# MongoDB Atlas Connection URI (Free 512MB M0 Cluster from https://cloud.mongodb.com)
# When set, all messages, users, and groups are permanently saved in the cloud.
# When omitted, the server automatically falls back to local JSON storage.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/secretbubble?retryWrites=true&w=majority

# Port for the Node.js Express server (Render provides this automatically)
PORT=5000

# Master Cryptographic Secrets
ENCRYPTION_SECRET=secret-bubble-aes-256-gcm-master-vault-2026-v2
JWT_SECRET=secret-bubble-session-hmac-sha256-signature-key-2026
